<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="#F5F7FB">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capture Notes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Type or paste your study content. The prototype stores notes locally using SharedPreferences."
        android:textSize="15sp"
        android:textColor="#64748B"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/etNotes"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:hint="Paste notes here..."
        android:gravity="top"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/btnSaveNotes"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Save Notes Locally"
        android:textAllCaps="false"
        android:layout_marginTop="18dp" />

    <Button
        android:id="@+id/btnLoadNotes"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Load Saved Notes"
        android:textAllCaps="false"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnClearNotes"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Clear Editor"
        android:textAllCaps="false"
        android:layout_marginTop="10dp"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textColor="#166534"
        android:layout_marginTop="18dp" />

</LinearLayout>