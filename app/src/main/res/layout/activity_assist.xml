<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Assist"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose an AI mode and generate a structured response."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp" />

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Ask MindMate AI something..."
            android:gravity="top"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnUseSavedNotes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Use Saved Notes"
            android:textAllCaps="false"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnExplain"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Explain"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnSummarise"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Summarise"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnRewrite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Rewrite Clearly"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/pbAssist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAIResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI output will appear here."
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>