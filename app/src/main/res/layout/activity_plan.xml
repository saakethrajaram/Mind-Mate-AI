<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan Generator"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a structured study or productivity plan from a goal."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp" />

        <EditText
            android:id="@+id/etGoal"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Example: Prepare for my Android GenAI app presentation"
            android:gravity="top"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnUseSavedNotesForPlan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Use Saved Notes"
            android:textAllCaps="false"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnCreatePlan"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Generate Plan"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/pbPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generated plan will appear here."
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>